<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Anaquel: subir fotos del anaquel y pedidos al servidor. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Escáner de códigos de barras (permiso en tiempo de ejecución). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Vibración al leer un código (permiso normal, se concede al instalar). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- La cámara no es obligatoria: sin ella la app funciona con captura manual. -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <!--
        Sin READ/WRITE_EXTERNAL_STORAGE: la galería usa el Photo Picker del sistema
        (no requiere permisos) y las fotos se guardan en el almacenamiento interno
        de la app (tampoco los requiere).
    -->

    <!--
        Sincronización P2P (Nearby Connections). Nearby combina Bluetooth, BLE y
        Wi-Fi directo; cada versión de Android exige un juego distinto de permisos.
    -->
    <!-- Android ≤ 11: Bluetooth "clásico". -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <!--
        Ubicación en TODAS las versiones: Nearby la exige para BUSCAR dispositivos
        (startDiscovery) incluso en Android 12+; sin ella falla con el error 8034.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Android 12+: permisos de Bluetooth "cercanos" (ya no dependen de ubicación). -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Android 13+: Wi-Fi directo con dispositivos cercanos (la vía rápida de la transferencia). -->
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" />
    <!-- Nearby cambia la radio Wi-Fi para la conexión directa (permisos normales). -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <!-- Android 13+: recordatorios de entrega de pedidos. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android 11+: permite encontrar la app de cámara para "Tomar foto". -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:name=".MiTiendaApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:exported="true"
            android:name=".MainActivity"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Comparte con la app de cámara un archivo temporal donde escribir la foto. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>