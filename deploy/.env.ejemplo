# Copia este archivo a deploy/.env (no se sube a git) y llena cada valor.
# Llaves de 32 bytes en base64:      openssl rand -base64 32
# Contraseñas (24+ caracteres):      openssl rand -base64 24

# Firma de la identidad entre la pasarela y los servicios
CLAVE_INTERNA=
# Cifrado de datos personales (correo, teléfono). Si se pierde, esos datos no se recuperan: respáldala aparte.
CLAVE_DATOS=
# Índice ciego del correo (búsquedas sin guardar el correo en claro)
CLAVE_INDICE=

# Postgres: superusuario y un usuario por servicio
PG_SUPER=
PG_ACCESO_PASSWORD=
PG_MERCADO_PASSWORD=
PG_REELS_PASSWORD=
PG_PAGOS_PASSWORD=

# Terminal virtual (demo) — firma de sus webhooks, 32+ caracteres
SIMULADOR_SECRETO=
# 1 = cuentas, catálogo y terminal virtual de demostración
DEMO=0

# Mercado Pago Point (Orders API). Token de producción o de prueba de la cuenta
# dueña de las terminales; secreto de "Webhooks" en Tus integraciones.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Clip PinPad API (confirmar campos en developer.clip.mx antes de producción)
CLIP_API_KEY=
CLIP_API_SECRET=
